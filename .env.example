# Copy to .env for local testing. On Render, set these in the service's Environment tab.

PORT=3000

# Where leads are stored. On Render, attach a persistent disk at /var/data and use:
# DB_PATH=/var/data/mainely.sqlite
DB_PATH=

# Admin dashboard login (/admin). Password must be 8+ characters or login stays disabled.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 16+ random characters. Signs the admin login cookie.
SESSION_SECRET=

# Lead email alerts (Gmail SMTP with an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Inbox(es) that receive new estimate requests. Comma-separate to alert more than one person,
# e.g. NOTIFY_EMAIL=treygagne@mainelyinsulation.com,scottregan@mainelyinsulation.com
NOTIFY_EMAIL=
# Customers who leave an email get a short "we got your request" reply. Set to false to turn off.
SEND_CONFIRMATION=true
# Public URL, used for the "View in dashboard" link in alert emails
SITE_URL=https://mainelyinsulation.com
